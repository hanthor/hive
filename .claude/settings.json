{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd src && go build ./...)",
      "Bash(cd src && go vet ./...)",
      "Bash(cd src && go test ./...)",
      "Bash(cd src && go test *)",
      "Bash(gofmt -l *)",
      "Bash(cd src && golangci-lint run ./...)",
      "Bash(node .github/scripts/check-inline-js.js *)",
      "Bash(bash bin/test_*.sh)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)"
    ]
  }
}
